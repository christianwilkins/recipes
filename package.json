{
  "name": "chriswiki-recipes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check scripts/build.mjs && node --check public/app.js && node --check public/groceries.js && node --check lib/groceries.mjs && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler pages dev dist --port 4178",
    "check:functions": "wrangler pages functions build --outdir .functions-build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:provision": "node scripts/provision-d1.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.146.0"
  }
}
